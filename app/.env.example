# 复制本文件为 .env，并填入真实值（.env 已被 .gitignore 排除，勿提交）

# 企微智能机器人（长连接模式）
BOT_ID=your_bot_id_here
BOT_SECRET=your_bot_secret_here

# DeepSeek
DEEPSEEK_API_KEY=sk-your_deepseek_api_key

# PostgreSQL 连接串（密码为空则省略 ":密码"）
# 本地开发（需 SSH 隧道把服务器 5432 映射到本机）：postgresql://postgres@127.0.0.1:5432/mydb
# 部署在云服务器（docker-compose 内部）：postgresql://postgres@postgres:5432/mydb
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/mydb
